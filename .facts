  command: TRACEQUEST_SKIP_LR_WATCH=1 node --test --test-name-pattern 'standup/handoff release alias is documented and wired' test/bin/tracequest.e2e.test.js
  tags: [spec, standup, handoff, docs, smoke, release, implemented]
- label: tracequest standup real-bin dry-run coverage proves CLI --agent-command drops lower-source agentArgs, params, and env args while CLI --agent-arg keeps a profile command and replaces profile args
  command: TRACEQUEST_SKIP_LR_WATCH=1 node --test --test-name-pattern 'standup mixed partial agent overrides through real bin' test/bin/tracequest.e2e.test.js
  tags: [spec, standup, profile, precedence, agent, real-bin, implemented]
- label: tracequest's standup/handoff release gate has a transitive package-script regression that expands release:standup-handoff through verify and smoke scripts, proving the gate remains synthetic-only and does not reference installed-agent probes or built-in prompt-agent executables
  command: TRACEQUEST_SKIP_LR_WATCH=1 node --test --test-name-pattern 'standup/handoff release gate script chain stays synthetic-only' test/bin/tracequest.e2e.test.js
