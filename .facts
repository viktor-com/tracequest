## session-flyout
- label: selecting a session row on / opens a right-hand #sessionFlyout while the Runs inventory #sessions remains on the page
  command: node --input-type=module -e "import { browserPageHTML } from \"./src/browser/browser-page-build.js\"; import { readFileSync } from \"node:fs\"; const h = browserPageHTML(JSON.stringify({sessions:[],total:0,page:1,pageSize:50,stats:{},liveSessions:[]}), \"\"); if (!h.includes(\"id=\\\"sessionFlyout\\\"\")) { console.error(\"missing #sessionFlyout\"); process.exit(1); } if (!h.includes(\"id=\\\"sessions\\\"\")) { console.error(\"missing #sessions\"); process.exit(1); } if (h.indexOf(\"id=\\\"sessions\\\"\") > h.indexOf(\"id=\\\"sessionFlyout\\\"\")) { console.error(\"inventory should precede flyout in the Runs shell\"); process.exit(1); } const client = readFileSync(\"src/browser/browser-client.js\",\"utf8\"); if (!client.includes(\"openSessionFlyout\")) { console.error(\"missing openSessionFlyout\"); process.exit(1); } if (!client.includes(\"a.session-row\")) { console.error(\"session row clicks are not intercepted for the flyout\"); process.exit(1); }"
