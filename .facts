# release
- label: tracequest full-transcript release metadata uses version 0.5.2 consistently in the package, lockfile and dated changelog entry
  id: rel052
  command: node --input-type=module -e 'import fs from "node:fs"; import assert from "node:assert/strict"; const p=JSON.parse(fs.readFileSync("package.json")), l=JSON.parse(fs.readFileSync("package-lock.json")); assert.equal(p.version,"0.5.2"); assert.equal(l.version,p.version); assert.equal(l.packages[""].version,p.version); assert.ok(fs.readFileSync("CHANGELOG.md","utf8").includes("## [0.5.2] - 2026-10-20"));'
  tags: [release-0-5-2, implemented]
