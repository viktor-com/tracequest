- label: UI design review note template includes a filled stale browser compare-selection example naming the changed surface, applied guides, evidence fact, focused test, and screenshot/browser-test decisions
  command: grep -Fq '## Filled Example: Stale Browser Compare Selection' docs/ui-design-review-note-template.md && grep -Fq 'Browser index compare selection bar' docs/ui-design-review-note-template.md && grep -Fq 'docs/ui-interaction-control-state-guidelines.md' docs/ui-design-review-note-template.md && grep -Fq 'docs/ui-result-state-guidelines.md' docs/ui-design-review-note-template.md && grep -Fq '9vh' docs/ui-design-review-note-template.md && grep -Fq 'node --test test/browser/browser-client.test.js --test-name-pattern "compare selection"' docs/ui-design-review-note-template.md && grep -Fq 'Screenshot examples: skipped' docs/ui-design-review-note-template.md && grep -Fq 'Browser/Playwright tests: skipped' docs/ui-design-review-note-template.md
  tags: [spec, docs, ui, design-review-example, implemented]
- UI docs post-audit covers anti-pattern guidance, the design review note template and stale compare example, the contributor start guide, the CONTRIBUTING link, companion backlinks, fact tags, and maintenance/review workflow references @spec @docs @ui @docs-post-audit @implemented
- label: UI guide package fact lifecycle audit confirms docs/ui guide facts are implemented and the package keeps discoverability plus maintenance evidence tags and references connected
  command: node -e 'const fs=require("fs"); const facts=fs.readFileSync(".facts","utf8"); const factChecks=[["UI style guidelines link to the rendered hover diagnostics audit",["discoverability","implemented"]],["UI docs package uses the main style guide as an index",["docs-index","implemented"]],["UI maintenance guidance defines how future UI changes keep companion docs",["maintenance-guidance","implemented"]],["Contributor documentation directs UI changes to the main UI style guide package",["discoverability","contributor-docs","implemented"]],["UI docs post-audit covers anti-pattern guidance",["docs-post-audit","implemented"]]]; for (const [needle,tags] of factChecks) { const idx=facts.indexOf(needle); if (idx<0) throw new Error("missing fact "+needle); const end=facts.indexOf("\n-", idx+1); const block=facts.slice(idx, end<0 ? facts.length : end); for (const tag of tags) if (!block.includes(tag)) throw new Error(needle+" missing "+tag); } const docsUi=(facts.match(/# docs[\s\S]*?# browser/)||[""])[0]; for (const block of docsUi.split("\n- ").slice(1)) { const tagText=(block.match(/tags: \[[^\]]+\]|@[^\n]+/)||[""])[0]; if (tagText.includes("docs") && tagText.includes("ui") && !tagText.includes("implemented")) throw new Error("docs/ui fact missing implemented: "+block.split("\n")[0]); } const guide=fs.readFileSync("docs/ui-style-design-guidelines.md","utf8"); const maint=fs.readFileSync("docs/ui-maintenance-evidence-sync.md","utf8"); const audit=fs.readFileSync("docs/ui-live-final-audit.md","utf8"); const contrib=fs.readFileSync("CONTRIBUTING.md","utf8"); for (const token of ["docs/rendered-hover-diagnostics-audit.md","Rendered hover diagnostics","docs/ui-maintenance-evidence-sync.md","docs/ui-design-review-note-template.md","docs/ui-anti-patterns-and-non-goals.md","docs/ui-live-final-audit.md"]) if (!guide.includes(token)) throw new Error("main guide missing "+token); for (const token of ["facts","companion docs","design review note"]) if (!maint.includes(token)) throw new Error("maintenance guide missing "+token); if (!audit.includes("implemented UI documentation facts remain tagged")) throw new Error("audit note missing fact-tag check"); if (!contrib.includes("docs/ui-style-design-guidelines.md")) throw new Error("CONTRIBUTING missing UI guide link");'
  tags: [spec, docs, ui, docs-lifecycle-audit, implemented]
- label: UI guide package states its ownership and change-history model: guide changes are maintained through facts, the maintenance evidence-sync guide, and concrete UI behavior changes
  command: grep -Fq 'Ownership And Change History' docs/ui-style-design-guidelines.md && grep -Fq 'maintained through facts' docs/ui-style-design-guidelines.md && grep -Fq 'docs/ui-maintenance-evidence-sync.md' docs/ui-style-design-guidelines.md && grep -Fq 'concrete UI behavior changes' docs/ui-style-design-guidelines.md
  tags: [spec, docs, ui, ownership-history, implemented]

# browser

## index
- label: browser index controls expose explicit accessible names and state for filter suggestions, dashboard collapse, sorting, pagination, quick filters, and compare selection
  command: TRACEQUEST_SKIP_LR_WATCH=1 node --test --test-concurrency=1 test/browser/browser-page-build.test.js test/browser/browser-client.test.js test/browser/browser-client-dashboard.test.js
  tags: [spec, ui, accessibility, browser-index, implemented]
- label: browser index keeps the compare action disabled when two selected compare handles no longer both resolve in the current result set, while leaving the clear-selection control available
  command: node --test test/browser/browser-client.test.js --test-name-pattern "compare selection"
  tags: [spec, ui, browser-index, compare-selection, implemented]

## runs-home
- label: the served / page titles the home surface Runs (document title Runs · tracequest and a visible Runs heading)
  command: node --input-type=module -e "import { browserPageHTML } from \"./src/browser/browser-page-build.js\"; const h = browserPageHTML(JSON.stringify({sessions:[],total:0,page:1,pageSize:50,stats:{},liveSessions:[]}), \"\"); if (!/<title>Runs · tracequest<\\/title>/.test(h)) { console.error(\"missing Runs title\"); process.exit(1); } if (!/<h1 class=\\\"runs-title\\\">Runs<\\/h1>/.test(h)) { console.error(\"missing Runs heading\"); process.exit(1); }"
  tags: [spec, runs-home, ui, implemented]
- label: the / app crumb names the surface Runs rather than a generic landing label
  command: grep -q "class=\"app-crumb\">Runs</span>" src/browser/browser-page-build.js
  tags: [spec, runs-home, ui, implemented]
- label: the / home is a full-width Runs inventory workspace, not a 720px centered landing card feed
  command: node --input-type=module -e "import { browserPageHTML } from \"./src/browser/browser-page-build.js\"; const h = browserPageHTML(JSON.stringify({sessions:[],total:0,page:1,pageSize:50,stats:{},liveSessions:[]}), \"\"); if (!h.includes(\"runs-home\")) { console.error(\"missing runs-home\"); process.exit(1); } if (!h.includes(\"max-width: none\")) { console.error(\"missing full-width max-width:none\"); process.exit(1); } if (/\\.container \\{ max-width: 720px/.test(h)) { console.error(\"still 720px landing container\"); process.exit(1); }"
  tags: [spec, runs-home, ui, implemented]
- label: the / inventory has a scan-first column header row (Source, ID, Run, Project, Model, Time, Duration, Tokens, Cost)
  command: node --input-type=module -e "import { browserPageHTML } from \"./src/browser/browser-page-build.js\"; const h = browserPageHTML(JSON.stringify({sessions:[],total:0,page:1,pageSize:50,stats:{},liveSessions:[]}), \"\"); const need = [\"runs-table-head\",\"Source\",\"ID\",\"Run\",\"Project\",\"Model\",\"Time\",\"Duration\",\"Tokens\",\"Cost\"]; for (const n of need) { if (!h.includes(n)) { console.error(\"missing \"+n); process.exit(1); } }"
