  command: TRACEQUEST_SKIP_LR_WATCH=1 node --test --test-concurrency=1 --test-name-pattern 'recent sort materializes only newest maxResults matches|recent-sorted handoff search|direct handoff command orders matching results by recency' test/sessions/scan-queries.test.js test/sessions/index-search-pipeline-perf.test.js test/cli/cli-commands.test.js
  tags: [handoff, cli-search, perf, implemented]
- label: tracequest handoff --sort recent or --sort date keeps quoted-phrase verification bounded by searchSessions' default phrase scan cap instead of forcing all candidate sessions to be scanned, so returned handoff rows remain exact phrase matches within the capped recency window while older phrase matches beyond the cap may be omitted
  command: TRACEQUEST_SKIP_LR_WATCH=1 node --test --test-concurrency=1 --test-name-pattern 'recent-sorted quoted phrase search respects phraseScanCap|direct handoff quoted recent sort keeps phrase verification capped' test/sessions/scan-queries.test.js test/cli/cli-commands.test.js
  tags: [spec, handoff, cli-search, perf, implemented]
