  command: TRACEQUEST_SKIP_LR_WATCH=1 node --test --test-concurrency=1 --test-name-pattern "fires only data-hotkey leaves whose element is inside the top overlay" test/browser/is-form-field.test.js test/browser/editable-guard.test.js
