[
  {
    "id": "openai-api-key",
    "description": "OpenAI API Key",
    "regex": "sk-[A-Za-z0-9]{16,}",
    "keywords": ["sk-"],
    "entropy": 3.0
  },
  {
    "id": "github-pat",
    "description": "GitHub Personal Access Token",
    "regex": "ghp_[A-Za-z0-9]{20,}",
    "keywords": ["ghp_"],
    "entropy": 3.0
  },
  {
    "id": "github-fine-grained-pat",
    "description": "GitHub Fine-Grained Personal Access Token",
    "regex": "github_pat_[A-Za-z0-9_]{20,}",
    "keywords": ["github_pat_"],
    "entropy": 3.0
  },
  {
    "id": "aws-access-key",
    "description": "AWS Access Key ID",
    "regex": "AKIA[0-9A-Z]{16}",
    "keywords": ["akia"],
    "entropy": 2.5
  },
  {
    "id": "generic-api-key",
    "description": "Generic API Key Assignment",
    "regex": "(?i)(?:api[_-]?key|apikey|secret[_-]?key|access[_-]?token)[\\s'\"`:=]{0,6}[\\s'\"`:=]{0,3}([A-Za-z0-9_\\-]{16,})",
    "keywords": ["api", "key", "secret", "token"],
    "secretGroup": 1,
    "entropy": 3.0
  },
  {
    "id": "bearer-token",
    "description": "Bearer Token",
    "regex": "(?i)bearer\\s+([A-Za-z0-9._\\-]{20,})",
    "keywords": ["bearer"],
    "secretGroup": 1,
    "entropy": 3.0
  },
  {
    "id": "private-key-block",
    "description": "Private Key Block",
    "regex": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----[\\s\\S]*?-----END (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
    "keywords": ["private", "key"],
    "flags": "g"
  },
  {
    "id": "huggingface-token",
    "description": "Hugging Face Access Token",
    "regex": "hf_[A-Za-z0-9]{20,}",
    "keywords": ["hf_"],
    "entropy": 3.0
  },
  {
    "id": "slack-token",
    "description": "Slack Token",
    "regex": "xox[baprs]-[0-9A-Za-z\\-]{10,}",
    "keywords": ["xox"],
    "entropy": 2.5
  },
  {
    "id": "stripe-secret-key",
    "description": "Stripe Secret Key",
    "regex": "sk_(?:live|test)_[0-9a-zA-Z]{16,}",
    "keywords": ["sk_live", "sk_test"],
    "entropy": 3.0
  }
]