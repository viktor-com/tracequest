  command: TRACEQUEST_SKIP_LR_WATCH=1 node --test --test-concurrency=1 --test-name-pattern 'page-name query keeps Go to|section-name query keeps in-view' test/browser/command-palette-nav.test.js test/browser/command-palette-sections.test.js
