- label: typing or pasting an 8-character session hash in the CommandPalette offers an Open session item that goes to /view?id=
  id: cpho
  command: TRACEQUEST_SKIP_LR_WATCH=1 node --test --test-concurrency=1 --test-name-pattern '8-character session hash|Open session item' test/browser/command-palette-search.test.js
