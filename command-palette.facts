- label: activating a CommandPalette session hit navigates to /view?id= of that session
  id: cppi
  command: TRACEQUEST_SKIP_LR_WATCH=1 node --test --test-concurrency=1 --test-name-pattern 'navigates to /view' test/browser/command-palette-search.test.js
  tags: [spec, command-palette, palette-search, implemented]
- label: a CommandPalette query that matches neither commands nor indexed sessions still shows the Search sessions fallback
  id: cpns
  command: TRACEQUEST_SKIP_LR_WATCH=1 node --test --test-concurrency=1 --test-name-pattern 'neither commands nor indexed sessions|Search sessions fallback' test/browser/command-palette-search.test.js test/browser/command-palette.test.js
  tags: [spec, command-palette, palette-search, implemented]
- label: CommandPalette session hits keep /api/search rank order inside a Sessions group above the Search fallback
  id: cpro
